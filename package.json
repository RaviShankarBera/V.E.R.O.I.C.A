{
  "name": "veronica-ai",
  "version": "1.0.0",
  "description": "Veronica AI — a local-first desktop AI companion with chat, memory, agent harness, agentic tasks, browser automation, system monitor, voice and messaging integrations. Original software by Ravi Shankar Bera.",
  "author": "Ravi Shankar Bera",
  "license": "MIT",
  "homepage": "https://github.com/RaviShankarBera/V.E.R.O.I.C.A",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaviShankarBera/V.E.R.O.I.C.A.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@picovoice/porcupine-node": "4.0.2",
    "@slack/socket-mode": "3.1.0",
    "@slack/web-api": "8.2.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "audio-decode": "^2.1.3",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.10.2",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "lucide-react": "1.61.0",
    "playwright-core": "1.64.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "systeminformation": "5.33.16",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@swc/core": "1.16.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.ravishankarbera.veronica",
    "productName": "Veronica AI",
    "artifactName": "VeronicaAI-${version}-setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
